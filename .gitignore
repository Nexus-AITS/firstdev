node_modules
dist
dist-ssr
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json
npm-debug.log*
yarn-error.log*

# environment — real keys never belong in the repo. SUPABASE_ANON_KEY is
# public by design (it is only as powerful as the RLS policies behind it) and
# is served at runtime by api/config.js rather than inlined, but a .env also
# holds SUPABASE_ACCESS_TOKEN (a PAT that can run DDL), so the whole family is
# ignored.
.env
.env.*
!.env.example

# supabase CLI local state (schema SQL files ARE tracked)
supabase/.temp/
supabase/.branches/

# local verification artifacts (screenshots, logs)
artifacts/
preview.log
preview.err

