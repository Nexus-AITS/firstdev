# Supabase project — backs Google sign-in and the /register wizard's
# registration sync.
#
# ⚠ These names carry NO VITE_ prefix, deliberately. Vite inlines every
#   VITE_-prefixed variable into the PUBLIC browser bundle at build time,
#   which pins a credential to a rebuild and leaves it in immutable CDN
#   assets. Instead, api/config.js (a Vercel function) reads SUPABASE_URL /
#   SUPABASE_ANON_KEY from the server environment and hands them to the
#   browser at runtime via GET /api/config. Rotate a key by redeploying the
#   function — no rebuild.
#
#   ⚠ NEVER put a service-role key (or the database connection string, which
#   carries the DB password) in SUPABASE_ANON_KEY. api/config.js decodes the
#   key and refuses to serve anything whose role is not "anon", so a
#   fat-fingered value fails loudly instead of being published. RLS is the
#   real gate: the only anon grant is a narrow INSERT, reads stay denied.
#
# Get the key: Supabase dashboard → Project Settings → API Keys →
# "anon" "public" (starts with eyJ… or sb_publishable_…).
#
# In Vercel: set these under Settings → Environment Variables with the SAME
# names and Production ticked. Do not add a VITE_ prefix — see above.

SUPABASE_URL=https://xvteqcvvjlxhwijwxbbq.supabase.co
SUPABASE_ANON_KEY=

# Optional — personal access token for `npm run db:migrate` (server-side only;
# the anon key cannot run DDL). Create at supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=

# Test participant for the verification harness (npm run verify:db — Phase 3).
# Create it once in Supabase -> Authentication -> Users -> "Add user" (email
# confirmed), then paste the credentials here. Harness-only: read by Node
# scripts, never by the browser.
SUPABASE_VERIFY_EMAIL=
SUPABASE_VERIFY_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Kept for reference only. This is the DATABASE connection string — it is NOT
# the anon key and must never get a VITE_ prefix (Vite ignores non-VITE vars,
# so it stays out of the bundle). It contains the DB password: rotate it if it
# has ever been shared or committed.
# SUPABASE_DB_CONNECTION_STRING=

# Operations console master credentials. Used ONLY by npm run verify:staff so the
# three-tier role checks run against a real master instead of a throwaway.
# Create the account once with: npm run staff:bootstrap
SUPABASE_STAFF_EMAIL=
SUPABASE_STAFF_PASSWORD=

# ---------------------------------------------------------------------------
# Mail - Resend. Read by api/send-mail.js (and the optional Cloudflare worker)
# on the SERVER ONLY. Never VITE_-prefixed: that would inline the key into the
# public bundle where anyone can read it.
#
#   RESEND_API_KEY  from https://resend.com/api-keys
#   SENDER_EMAIL    a sender on a VERIFIED Resend domain. Until the domain is
#                   verified Resend refuses everything except onboarding@resend.dev,
#                   and every job fails with "domain not verified" until you do.
#
# The whole mail system degrades safely without these: the trigger still queues,
# the console still composes, and jobs simply sit at "queued" with the reason
# shown. Nothing is lost and nothing is half-sent.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SENDER_EMAIL=

# ---------------------------------------------------------------------------
# Mail - the MANUAL sender (console "Run the sender now" -> POST /api/send-mail)
# ---------------------------------------------------------------------------
# There is NO scheduled sender. `crons` has been removed from vercel.json, so
# nothing wakes this endpoint on its own. See docs/vercel-crons.md for why, and
# for what the queue does instead.
#
# Nothing below is needed. The console's "Run the sender now" button calls the
# same endpoint with the operator's own staff token and drains the queue by
# hand. `npm run mail:send` does the same from a machine.
#
# CRON_SECRET and MAIL_STAFF_TOKEN are retained ONLY as the documented inputs to
# the `isCron` branch in api/send-mail.js, which stays in the code because the
# file is a handler and not a policy: if a scheduled sender is ever reinstated
# correctly — a Pro plan, a real CRON_SECRET, a durable worker token — it should
# not need a rewrite of the delivery path to come back. Leave both EMPTY: an
# unset CRON_SECRET makes `isCron` false, so the branch is inert and every hit
# must carry a real staff token. That is the safe state, and it is the state this
# deployment has been in all along, which is exactly why the queue filled up.
# ---------------------------------------------------------------------------
CRON_SECRET=
MAIL_STAFF_TOKEN=