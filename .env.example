# Copy to `.env` and fill in from Supabase → Project Settings → API.
# `.env` is gitignored; only this template is committed.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Optional — personal access token for `npm run db:migrate` (server-side only;
# the anon key cannot run DDL). Create at supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=
